# ChangeNow API (서버 전용 — /api/swap 라우트에서만 사용)
CHANGENOW_API_KEY=your_key_here

# Feee.io API (서버 전용 — /api/energy 라우트에서만 사용)
# 발급 후 Feee.io 대시보드에서 이 서버의 IP를 화이트리스트에 등록해야 호출이 허용됩니다
# 키에 연결된 플랫폼 잔액(TRX 선충전)에서 비용이 차감되는 구조입니다
FEEE_API_KEY=your_key_here

# 사이트 URL
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# 관리자 페이지(/admin) 로그인 비밀번호 — 배너 광고/스왑·에너지 임대 온오프 관리
# 설정하지 않으면 /admin 로그인이 항상 실패합니다 (기본적으로 잠겨있음)
ADMIN_PASSWORD=your_password_here
